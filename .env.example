# Dev Launcher — local configuration & environment-specific values.
# Copy this file to `.env` (same folder as DevLauncher.exe) and fill in real
# values. `.env` is git-ignored so secrets never get committed.

# 🧩 Logic Apps launcher — lists both Standard workflows and Consumption apps.
# Folder whose immediate subfolders are the Standard Logic App workflow names.
LOGIC_APPS_REPO=C:\Dev\your-logic-apps-repo\app
# Azure resource that hosts the STANDARD workflows (used to build the portal
# deep-link). The subscription id is ALSO used to enumerate every CONSUMPTION
# logic app across the subscription via `az resource list` (REPULL) — each
# consumption app opens under its own resource group, so no extra id is needed.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_LOGIC_APP_SITE=your-logic-app-site
AZURE_LOGIC_APP_LOCATION=West US

# 🔑 Token manager — production Key Vault (RBAC mode). GET needs Key Vault
# Secrets User; SET (writing a new value/version) needs Secrets Officer.
KEYVAULT_NAME=your-key-vault-name
